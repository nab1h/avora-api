{
  "info": {
    "name": "Avora Product Catalog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run against a development/test database after applying the five additive catalog migrations. Configure base_url (origin without /api), admin credentials or token. Run folders in order. Select local files for the two upload requests; these cannot run unattended until files are selected. Existing gallery uploads survive cleanup. No credentials are included."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "gallery_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "gallery_item_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "image_id",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"run_id\")) pm.collectionVariables.set(\"run_id\", String(Date.now()));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login with existing administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/login",
            "description": "Existing login endpoint. Requires an active user with manage-settings under the sanctum permission guard. You may instead set token manually.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", body.token);",
                  "if (pm.response.code === 200) pm.environment.set(\"token\", body.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Category gallery",
      "item": [
        {
          "name": "Create gallery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/admin/galleries",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lighting gallery {{run_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Envelope\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"Message\", () => pm.expect(body.message).to.be.a(\"string\"));",
                  "pm.test(\"Data field\", () => pm.expect(body).to.have.property(\"data\"));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"gallery_id\", body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload existing gallery items (select files)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/gallery",
            "description": "Existing upload behavior is preserved. Choose local files before sending.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images[]",
                  "type": "file",
                  "src": [],
                  "description": "Choose a local JPG/PNG/WebP file, max 2 MiB."
                },
                {
                  "key": "images[]",
                  "type": "file",
                  "src": [],
                  "description": "Choose a local JPG/PNG/WebP file, max 2 MiB."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"gallery_item_id\", body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Assign existing gallery item without copying",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/admin/galleries/{{gallery_id}}",
            "description": "item_ids explicitly REPLACES membership. Other items are detached, never deleted. An item assigned elsewhere moves here.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_ids\": [\n    \"{{gallery_item_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Envelope\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"Message\", () => pm.expect(body.message).to.be.a(\"string\"));",
                  "pm.test(\"Data field\", () => pm.expect(body).to.have.property(\"data\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List galleries (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/admin/galleries?per_page=15",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Envelope\", () => pm.expect(body.success).to.eql(true));",
                  "pm.test(\"Message\", () => pm.expect(body.message).to.be.a(\"string\"));",
                  "pm.test(\"Data field\", () => pm.expect(body).to.have.property(\"data\"));",
                  "pm.test(\"Collection\", () => pm.expect(body.data).to.be.an(\"array\"));",
                  "pm.test(\"Pagination\", () => { [\"current_page\", \"per_page\", \"total\", \"last_page\"].forEach(k => pm.expect(body.meta[k]).to.be.a(\"number\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Show gallery",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/admin/galleries/{{gallery_id}}",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Envelope\", () => pm.expect(body.success).to.eql(true));",
